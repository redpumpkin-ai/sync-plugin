{
  "description": "Sync: pengingat ticket saat sesi mulai, pengingat update plugin (sekali sehari), dokumentasi sebelum berhenti, dan tawaran ticket berikutnya setelah IN_REVIEW atau DONE. Matikan dengan SYNC_HOOKS=off.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-guard.mjs\" session-start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-guard.mjs\" update-check",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-guard.mjs\" stop",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "change_ticket_status$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-guard.mjs\" post-tool-use",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
